# Copy to .env for local development. Never commit the real .env file.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///fintrack.db
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173
JWT_EXPIRES_MINUTES=60
# Set to true to create the demo user + sample data on start
SEED_DEMO=true
DEMO_USERNAME=demo
DEMO_PASSWORD=Demo@12345
